#!/bin/bash
_top=$(git rev-parse --show-toplevel 2>/dev/null); if [ -n "$_top" ] && [ "$_top" != "${CONKER_ROOT:-$HOME/conker}" ]; then echo "refusing: cwd repo $_top != CONKER_ROOT ${CONKER_ROOT:-$HOME/conker} (run: eval \"\$(tools/eu_port/wt.sh env <name>)\")" >&2; exit 3; fi
# usage: try <func> [draft.c]   (draft from stdin if omitted) -> screen result for one draft
# TRYDIR=name uses build/<name> (parallel use). V=1 try ... prints word diff (ref, mine, asm). Runs screen.py on a single draft in conker/build/t (host side; uses container conkerdev).
export PATH=/Applications/Docker.app/Contents/Resources/bin:$PATH
f=$1; T=${TRYDIR:-t}; d=${CONKER_ROOT:-$HOME/conker}/conker/build/$T; rm -rf $d; mkdir -p $d
if [ -n "$2" ]; then cp "$2" $d/$f.c; else cat > $d/$f.c; fi
cp ${CONKER_ROOT:-$HOME/conker}/tools/eu_port/m2c/screen.py ${CONKER_ROOT:-$HOME/conker}/conker/build/screen.py
docker exec -e SCREEN_KEEP="$SCREEN_KEEP" -e SCREEN_KEEPC="$SCREEN_KEEPC" -e SCREEN_OPT="$SCREEN_OPT" -e SCREEN_V=$V -e SCREEN_DATAREL=$SCREEN_DATAREL -e SCREEN_TMP=build/screen_$T -w /conker/conker ${CONKERDEV:-conkerdev} python3 build/screen.py build/$T 1 >/dev/null 2>&1
cut -d' ' -f1 $d/screen.txt; [ -f $d/errs/$f.txt ] && cat $d/errs/$f.txt
[ -n "$V" ] && [ -f $d/$f.diff ] && cat $d/$f.diff
true
