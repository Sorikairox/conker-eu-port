#!/bin/bash
# usage: try <func> [draft.c]   (draft from stdin if omitted) -> screen result for one draft
# V=1 try ... prints word diff (ref, mine, asm). Runs screen.py on a single draft in conker/build/t (host side; uses container conkerdev).
export PATH=/Applications/Docker.app/Contents/Resources/bin:$PATH
f=$1; d=~/conker/conker/build/t; rm -rf $d; mkdir -p $d
if [ -n "$2" ]; then cp "$2" $d/$f.c; else cat > $d/$f.c; fi
cp ~/conker/tools/eu_port/m2c/screen.py ~/conker/conker/build/screen.py
docker exec -e SCREEN_V=$V -w /conker/conker conkerdev python3 build/screen.py build/t 1 >/dev/null 2>&1
cut -d' ' -f1 $d/screen.txt; [ -f $d/errs/$f.txt ] && cat $d/errs/$f.txt
[ -n "$V" ] && [ -f $d/$f.diff ] && cat $d/$f.diff
true
