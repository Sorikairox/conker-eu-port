#!/bin/bash
# usage: tryall <func> draft1.c draft2.c ...  -> screen result per draft (one container run per draft set)
# Drafts go to conker/build/ta/<i>/<func>.c; prints "<result> <draft>".
export PATH=/Applications/Docker.app/Contents/Resources/bin:$PATH
f=$1; shift; d=~/conker/conker/build/ta; rm -rf $d; i=0
for x in "$@"; do mkdir -p $d/$i; cp "$x" $d/$i/$f.c; i=$((i+1)); done
cp ~/conker/tools/eu_port/m2c/screen.py ~/conker/conker/build/screen.py
docker exec -e SCREEN_OPT="$SCREEN_OPT" -w /conker/conker conkerdev bash -c "for k in \$(ls build/ta); do SCREEN_TMP=build/ta/\$k/tmp python3 build/screen.py build/ta/\$k 1 >/dev/null 2>&1 & done; wait"
i=0; for x in "$@"; do echo "$(cut -d' ' -f1 $d/$i/screen.txt) $x"; i=$((i+1)); done
