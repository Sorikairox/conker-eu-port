#!/bin/bash
# usage: flags src_eu/X.c [flagset ...]   (default flagsets: "-O1" "-O2" "-g" "-O2 -g3")
# Builds the file with each OPT_FLAGS override (written into conker/Makefile next to the other
# EU-only overrides) and prints the check_files/check_funcs summary for each. Leaves the LAST
# flagset in the Makefile: re-run with the one you want (or remove the line for the default).
# Note: make does not rebuild an object when only the Makefile changes; this script deletes it.
cd ${CONKER_ROOT:-$HOME/conker}/conker
f=$1; shift; [ $# -eq 0 ] && set -- "-O1" "-O2" "-g" "-O2 -g3"
for fl in "$@"; do
  perl -i -ne "print unless m|^\\\$\\(BUILD_DIR\\)/\Q$f\E.o: OPT_FLAGS|" Makefile
  if [ "$fl" != "-O2 -g3" ]; then
    perl -i -pe "s|^(\\\$\\(BUILD_DIR\\)/src_eu/game_eu_21D050.c.o: OPT_FLAGS := -O2\n)|\$1\\\$(BUILD_DIR)/$f.o: OPT_FLAGS := $fl\n|" Makefile
  fi
  echo "== $fl"; ${CONKER_ROOT:-$HOME/conker}/tools/eu_port/m2c/cf $f 2>&1 | grep -v '^?? ' | tail -${N:-4}
done
