#!/bin/bash
_top=$(git rev-parse --show-toplevel 2>/dev/null); if [ -n "$_top" ] && [ "$_top" != "${CONKER_ROOT:-$HOME/conker}" ]; then echo "refusing: cwd repo $_top != CONKER_ROOT ${CONKER_ROOT:-$HOME/conker} (run: eval \"\$(tools/eu_port/wt.sh env <name>)\")" >&2; exit 3; fi
# usage: screenall <dir under conker/, e.g. build/sg>  -> screens every v*/ subdir (container), merges the
# first OK per function into <dir>/final (merge.py) and prints a summary (best result per function).
export PATH=/Applications/Docker.app/Contents/Resources/bin:$PATH
d=$1; cp ${CONKER_ROOT:-$HOME/conker}/tools/eu_port/m2c/screen.py ${CONKER_ROOT:-$HOME/conker}/conker/build/screen.py
for v in ${CONKER_ROOT:-$HOME/conker}/conker/$d/v*/; do
  docker exec -w /conker/conker ${CONKERDEV:-conkerdev} python3 build/screen.py $d/$(basename $v) 8 >/dev/null 2>&1
done
cd ${CONKER_ROOT:-$HOME/conker}/conker && python3 ${CONKER_ROOT:-$HOME/conker}/tools/eu_port/m2c/merge.py $d/final $d/v* >/dev/null 2>&1
cat $d/v*/screen.txt | awk '{r=$1; f=$2; if(r=="OK")s=0; else if(r~/^DIFF/){s=substr(r,5)+0}else s=1000; if(!(f in b)||s<b[f]){b[f]=s;br[f]=r}} END{for(f in b)print br[f],f}' | sort
